# ============================================================================
# Configuration de l'outil Zendesk -> Jira
# ----------------------------------------------------------------------------
# 1. Copie ce fichier en ".env" :   cp .env.example .env
# 2. Remplis les valeurs ci-dessous.
# 3. Le ".env" n'est JAMAIS committe (il est dans .gitignore). Ce fichier-ci,
#    ".env.example", ne contient que des placeholders : il sert de documentation
#    des variables attendues, et lui peut etre versionne sans risque.
# ============================================================================


# --- ZENDESK ----------------------------------------------------------------

# Sous-domaine = la partie avant ".zendesk.com" dans l'URL de ton instance.
# La tienne : https://vodfactoryhelp.zendesk.com  ->  vodfactoryhelp
ZENDESK_SUBDOMAIN=vodfactoryhelp

# Email du compte Zendesk qui a genere le token API ci-dessous.
ZENDESK_EMAIL=prenom.nom@vodfactory.com

# Token API Zendesk. A generer dans :
#   Admin Center > Apps and integrations > Zendesk API > Settings
#   > Token access > "+ Add API token"
# /!\ Affiche UNE SEULE FOIS a la creation : copie-le tout de suite.
ZENDESK_API_TOKEN=


# --- JIRA -------------------------------------------------------------------

# URL de base de ton instance Jira Cloud (sans slash final).
JIRA_BASE_URL=https://vodfactory.atlassian.net

# Email de ton compte Atlassian.
JIRA_EMAIL=prenom.nom@vodfactory.com

# Token API PERSONNEL Atlassian (PAS besoin de droits admin).
# A generer ici : https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Cle du projet Jira de destination.
JIRA_PROJECT_KEY=BUGOTTO


# ============================================================================
# IDENTIFIANTS A DECOUVRIR A L'ETAPE 1b
# Laisse-les VIDES pour l'instant. On les remplira ensemble, via des petites
# requetes API (le script de decouverte affichera les valeurs a coller ici).
# ============================================================================

# Champ custom Zendesk "Cle Jira liee" (la memoire anti-doublon).
# ID numerique du champ (ex. 360001234567).
ZENDESK_JIRA_KEY_FIELD_ID=

# Champ custom Zendesk qui contient le client / la plateforme concernee.
# ID numerique du champ.
ZENDESK_CLIENT_FIELD_ID=

# Champ custom Jira "Plateforme (client ID)".
# Identifiant Jira, de la forme customfield_XXXXX (ex. customfield_10050).
JIRA_PLATFORM_FIELD_ID=

# accountId Jira de El Amrani Soufiane (assigne par defaut des bugs apps TV/Mobile).
JIRA_ASSIGNEE_SOUFIANE=

# accountId Jira du compte "Tech VODF" (assigne par defaut dans tous les autres cas).
JIRA_ASSIGNEE_TECH_VODF=

# ----------------------------------------------------------------------------
# Reformulation de la description par l'IA (interface web, brief v2).
# ----------------------------------------------------------------------------
# Cle API Anthropic (compte VODF). Sert a transformer le texte du ticket en
# rapport de bug structure pour la tech. Reste cote serveur, jamais dans le navigateur.
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# Multi-utilisateur / prod (v3) : login + tokens Jira par utilisateur.
# ----------------------------------------------------------------------------
# Cle de signature des cookies de session (login). Doit etre longue et secrete.
#   Generer :  python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=

# Cle de chiffrement des tokens Jira stockes en base (Fernet). Format Fernet.
#   Generer :  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# /!\ Si tu changes cette cle, les tokens deja chiffres deviennent illisibles
#     (les utilisateurs devront re-saisir leur token).
TOKEN_ENCRYPTION_KEY=

# Chemin du fichier de base de comptes (SQLite). Defaut : comptes.db a cote du code.
# En prod sur Railway : pointer vers un VOLUME persistant (sinon la base est
# effacee a chaque redeploiement), ex. /data/comptes.db.
APP_DB_PATH=
